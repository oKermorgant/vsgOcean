<?xml version="1.0"?>
<!-- vsgOcean floatgen: a floating wind turbine, converted from the floatgen
     xacro (URDF macro, floating variant). The meshes are the original COLLADA
     converted to glTF (the COLLADA loader path ignores the scene lights); the
     pole mesh is baked with a +90 deg X rotation - its vertex data was authored
     along +Y in a file declaring Z up, while the blades joint expects the tower
     vertical (the rotor sits at z = 16.864, the tower top).
     The rotor joint "floatgen" (axis X) is spun by the demo animation. -->
<sdf version="1.9">
  <model name="floatgen">
    <pose>40 -40 0 0 0 0</pose>

    <link name="floatgen/base_link">
      <inertial>
        <mass>10</mass>
        <inertia>
          <ixx>0.4</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.4</iyy><iyz>0</iyz><izz>0.2</izz>
        </inertia>
      </inertial>
      <visual name="floatgen/base_air">
        <geometry>
          <mesh>
            <uri>meshes/base_air.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name="floatgen/base_water">
        <geometry>
          <mesh>
            <uri>meshes/base_water.glb</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- the tower: the xacro's floating variant offsets it aft of the platform
         (in SDF the CHILD LINK's pose places it - unlike URDF, the joint pose
         does not) -->
    <link name="floatgen/pole">
      <pose relative_to="floatgen/base_link">-9 0 0 0 0 0</pose>
      <inertial>
        <mass>10</mass>
        <inertia>
          <ixx>0.4</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.4</iyy><iyz>0</iyz><izz>0.2</izz>
        </inertia>
      </inertial>
      <visual name="floatgen/pole">
        <geometry>
          <mesh>
            <uri>meshes/pole.glb</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="floatgen_floating" type="fixed">
      <parent>floatgen/base_link</parent>
      <child>floatgen/pole</child>
    </joint>

    <!-- the rotor: continuous joint about X, spun by the demo animation; the
         blades sit at the tower top (the xacro's joint origin) -->
    <link name="floatgen/blades">
      <pose relative_to="floatgen/pole">0.71 0 16.864 0 0 0</pose>
      <inertial>
        <mass>10</mass>
        <inertia>
          <ixx>0.4</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.4</iyy><iyz>0</iyz><izz>0.2</izz>
        </inertia>
      </inertial>
      <visual name="floatgen/blades">
        <geometry>
          <mesh>
            <uri>meshes/blades.glb</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="floatgen" type="continuous">
      <parent>floatgen/pole</parent>
      <child>floatgen/blades</child>
      <axis>
        <xyz>1 0 0</xyz>
      </axis>
    </joint>
  </model>
</sdf>
