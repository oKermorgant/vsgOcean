<?xml version="1.0"?>
<!-- vsgOcean floatgen: a floating wind turbine built from the FLOATGEN
     demonstrator's published dimensions (Ideol "Damping Pool" concrete
     foundation, Vestas V80-2.0MW turbine): square concrete foundation 36 m
     per side with cut corners, overall breadth 40.2 m (the deck rim), depth
     9.5 m, draught 7.0-7.5 m (7.25 in the model), hub height 60 m, rotor
     diameter 80 m. The Ideol layout follows the earlier vsgOcean model:
     chamfered corners (legs 24% of the half side) and the central damping
     pool (59% of the hull side, open through the structure). The caisson
     carries a procedural albedo: a uniform mussel carpet over the concrete
     with a dark waterline band; the underwater part is a separate mesh
     (base_water) so the two can diverge.
     Modelled in-house from those dimensions; the generator scripts are kept
     in LLM/tmp (make_floatgen.py, make_growth.py).
     The rotor joint "floatgen" (axis X) is spun by the demo animation. -->
<sdf version="1.9">
  <model name="floatgen">
    <pose>40 -40 0 0 0 0</pose>

    <link name="floatgen/base_link">
      <inertial>
        <mass>10</mass>
        <inertia>
          <ixx>0.4</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.4</iyy><iyz>0</iyz><izz>0.2</izz>
        </inertia>
      </inertial>
      <visual name="floatgen/base_air">
        <geometry>
          <mesh>
            <uri>meshes/base_air.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name="floatgen/base_water">
        <geometry>
          <mesh>
            <uri>meshes/base_water.glb</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- the tower stands aft of the damping pool, its base fully on the
         concrete deck (tangent to the pool wall at -10.58: the tower base
         radius 1.75 puts the pole centre at -12.5) -->
    <link name="floatgen/pole">
      <pose relative_to="floatgen/base_link">-12.5 0 0 0 0 0</pose>
      <inertial>
        <mass>10</mass>
        <inertia>
          <ixx>0.4</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.4</iyy><iyz>0</iyz><izz>0.2</izz>
        </inertia>
      </inertial>
      <visual name="floatgen/pole">
        <geometry>
          <mesh>
            <uri>meshes/pole.glb</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="floatgen_floating" type="fixed">
      <parent>floatgen/base_link</parent>
      <child>floatgen/pole</child>
    </joint>

    <!-- the rotor: continuous joint about X, spun by the demo animation;
         the hub sits at the tower top, 60 m above the waterline (the
         V80-2.0MW hub height), rotor diameter 80 m -->
    <link name="floatgen/blades">
      <pose relative_to="floatgen/pole">0.71 0 60 0 0 0</pose>
      <inertial>
        <mass>10</mass>
        <inertia>
          <ixx>0.4</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.4</iyy><iyz>0</iyz><izz>0.2</izz>
        </inertia>
      </inertial>
      <visual name="floatgen/blades">
        <geometry>
          <mesh>
            <uri>meshes/blades.glb</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="floatgen" type="continuous">
      <parent>floatgen/pole</parent>
      <child>floatgen/blades</child>
      <axis>
        <xyz>1 0 0</xyz>
      </axis>
    </joint>
  </model>
</sdf>
