<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="islands">

    <!-- Geolocation of the scene: Pornichet, France -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>47.1075</latitude_deg>
      <longitude_deg>-2.3533</longitude_deg>
      <elevation>5.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Directional light (sun) -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>
      <direction>-0.5 -0.5 -1.0</direction>
    </light>

    <!-- Ambient light -->
    <light name="ambient" type="directional">
      <diffuse>0.2 0.2 0.2 1.0</diffuse>
    </light>

    <!-- Islands model -->
    <model name="islands">
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
        <pose>0 0 50 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>islands.glb</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>
