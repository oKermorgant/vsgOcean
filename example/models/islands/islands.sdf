<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="islands">

    <!-- Geolocation of the scene: Pornichet, France -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>47.1075</latitude_deg>
      <longitude_deg>-2.3533</longitude_deg>
      <elevation>5.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- no <light> elements: vsgOcean's environment drives the sun (and the night
         darkness); Gazebo-style decorative world lights would double-light the scene
         and stay on at night -->

    <!-- Islands model -->
    <model name="islands">
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
        <pose>0 0 50 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>islands.glb</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>
